# Apache (.htaccess en la carpeta donde subes dist/). Requiere mod_headers, mod_rewrite y mod_mime.
Options -Indexes

<IfModule mod_mime.c>
  AddType "text/calendar; charset=utf-8" .ics
  # Pestaña Python (LABS_PYTHON=1): WebAssembly con su tipo, para compilarlo mientras se descarga.
  AddType application/wasm .wasm
  AddType application/zip .whl
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
  Header always set X-Robots-Tag "noindex, nofollow"
  # Worker de la pestaña Python: su propia CSP añade 'wasm-unsafe-eval' (Pyodide compila WebAssembly
  # dentro del worker). La del documento no cambia.
  <FilesMatch "^py\.worker-[A-Za-z0-9_-]+\.js$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|wasm|whl|zip)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(ics|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Service worker: sin caché (va después de la regla de los .js), para que se vea cada versión nueva.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Fallback SPA: las rutas sin fichero sirven index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
