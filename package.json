{
  "name": "ia-labs-comunidad",
  "version": "0.5.0",
  "private": true,
  "description": "Laboratorios interactivos para estudiantes del Máster en IA: simbología, lógica, Markov, álgebra de Boole, calendario, flashcards y calculadora de notas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AglaDigSol/ia-labs-comunidad.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/zod-config.ts"
  ],
  "exports": {
    ".": "./src/embed/index.ts",
    "./shared/*": "./shared/*",
    "./content/*": "./content/*",
    "./tokens.css": "./src/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-ics.ts dist",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:consumer": "tsc -p tests/consumer/tsconfig.json --noEmit",
    "lint:install": "npm ci --prefix tools/lint --ignore-scripts --no-audit --no-fund",
    "lint": "tools/lint/node_modules/.bin/eslint -c tools/lint/eslint.config.js --max-warnings 0 ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.19.0",
    "lucide-react": "1.61.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
