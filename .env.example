# Copia este fichero como .env.local (no se sube a git) si necesitas cambiar algo en local.

# Ruta base del sitio. "/" si se sirve en la raíz de un dominio o subdominio; "/labs/" si va en una subcarpeta.
VITE_BASE=/

# Feed iCalendar externo opcional, solo en build (npm run build o docker build --build-arg).
# Se fusiona con content/calendario. Nunca llega al navegador. NO uses un feed con datos personales:
# todo el que abra el sitio verá sus eventos (aunque no la URL).
CALENDAR_ICS_URL=
